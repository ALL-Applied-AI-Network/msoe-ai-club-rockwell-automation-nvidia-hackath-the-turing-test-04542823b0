# Copy this file to .env and fill in your own values. Never commit .env.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Mac:                 cp .env.example .env

# Your key from build.nvidia.com (also used to download the Cosmos container on Brev).
# A local Cosmos NIM container ignores it; a hosted endpoint would need it.
NVIDIA_API_KEY=

# Where scripts/ask_cosmos.py sends requests. The default is our Cosmos NIM on Brev,
# reached through: brev port-forward fluid-cosmos --port 8000:8000
COSMOS_BASE_URL=http://127.0.0.1:8000/v1
COSMOS_MODEL=nvidia/cosmos3-nano-reasoner
